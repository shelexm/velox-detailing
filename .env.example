# Copy to .env and replace every placeholder:  cp .env.example .env
# Never commit .env. Generate passwords with:  openssl rand -base64 32

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=velox
POSTGRES_USER=velox
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Public address of the site (tunnel or domain). Used for links in Telegram messages and cookies.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated host names the app answers to. Wildcards like *.trycloudflare.com are allowed.
ALLOWED_HOSTS=127.0.0.1,localhost
# true behind HTTPS (tunnel or domain); development defaults to false.
COOKIE_SECURE=false

API_PORT=8000
DEFAULT_STUDIO_SLUG=velox

# Telegram bot (leave empty to keep the bot disabled)
TELEGRAM_BOT_TOKEN=

# Backups written by the backup service
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
